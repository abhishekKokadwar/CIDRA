# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
CIDRA_API_KEY=
CIDRA_BASE_URL=https://openrouter.ai/api/v1
CIDRA_MODEL_ANALYZE=anthropic/claude-haiku-4.5
CIDRA_MODEL_FIX=anthropic/claude-sonnet-4.5

# GitHub, fine-grained PATs scoped to one practice repo. Two of them on purpose.
# _RO is what reads logs: Actions:read + Contents:read. A CI log is untrusted
# input, so the code that parses one cannot write to the repo.
# The write token (Contents:rw, Pull requests:rw) is only for opening a PR in
# Phase 6. Neither grants Workflows — an agent that can edit ci.yml can turn CI
# green by deleting the tests.
CIDRA_GITHUB_TOKEN_RO=
CIDRA_GITHUB_TOKEN=
CIDRA_PRACTICE_REPO_SLUG=
